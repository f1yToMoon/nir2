# Скопировать в infra/.env и при необходимости изменить.
# Все версии зафиксированы на этапе 0 командой `make versions-check`.

COMPOSE_PROJECT_NAME=nir

# --- Iceberg ---
ICEBERG_VERSION=1.12.0
# apache/iceberg-rest-fixture:1.12.0 отсутствует на Docker Hub (ADR-001).
# Закреплено по digest — latest (2026-04-29, ≥1.11, совместим с клиентом 1.12.0).
CATALOG_FIXTURE_TAG=latest
CATALOG_FIXTURE_DIGEST=sha256:db8de90b5b7693d4ac334c336f91d9bbe320d7b19f4f514d26de84cdfbcbfe8d

# --- Spark (Iceberg 1.12 поддерживает Spark 3.5 / 4.0 / 4.1) ---
SPARK_VERSION=4.0.1
SCALA_BINARY_VERSION=2.13
SPARK_IMAGE=apache/spark:4.0.1-scala2.13-java17-python3-ubuntu
ICEBERG_SPARK_RUNTIME_ARTIFACT=iceberg-spark-runtime-4.0_2.13
# Запасной вариант при проблемах совместимости:
# SPARK_IMAGE=apache/spark:3.5.7-scala2.12-java17-python3-ubuntu
# ICEBERG_SPARK_RUNTIME_ARTIFACT=iceberg-spark-runtime-3.5_2.12

# --- Flink (Iceberg 1.12: Flink 1.20, 2.1, 2.2, 2.3) ---
FLINK_IMAGE=flink:1.20.3-scala_2.12-java17
FLINK_MINOR=1.20
ICEBERG_FLINK_RUNTIME_ARTIFACT=iceberg-flink-runtime-1.20
FLINK_KAFKA_CONNECTOR_VERSION=3.4.0-1.20
HADOOP_CLIENT_VERSION=3.3.6

# --- Прочие образы ---
# SeaweedFS: обновлено 3.97→4.48 (3.97 хранит aws-chunked тела verbatim — ADR-003).
SEAWEEDFS_VERSION=4.48
AWSCLI_VERSION=2.27.0
TOXIPROXY_VERSION=2.12.0
KAFKA_IMAGE=apache/kafka:3.9.1
POSTGRES_VERSION=16
PROMETHEUS_VERSION=v3.5.0
GRAFANA_VERSION=12.1.0
# Lakekeeper: v0.14.0 — последний стабильный релиз (2026-10-07).
LAKEKEEPER_VERSION=v0.14.0
PYTHON_IMAGE=python:3.11-slim

# --- Доступ к S3 (SeaweedFS) ---
AWS_ACCESS_KEY_ID=nir-access
AWS_SECRET_ACCESS_KEY=nir-secret-change-me
AWS_REGION=us-east-1
S3_BUCKET=warehouse
WAREHOUSE=s3://warehouse/

# --- Маршрутизация каталога ---
# proxy:  клиенты → capl:8180 → каталог
# bypass: клиенты → каталог напрямую (контрольные прогоны E1)
CATALOG_ROUTING=proxy
# rest_fixture | lakekeeper
CATALOG_IMPL=rest_fixture
# для lakekeeper: http://lakekeeper:8181/catalog
CAPL_UPSTREAM_URI=http://catalog:8181
LAKEKEEPER_WAREHOUSE_NAME=bench

# --- CAPL ---
CAPL_POLICY=P0
CAPL_PG_DSN=postgresql://capl:capl@postgres:5432/telemetry
CAPL_S3_ENDPOINT=http://toxiproxy:18333
CAPL_MODEL_DIR=/models/current

# --- Ресурсы (профиль full; для lite см. 07_hardware_and_deployment.md) ---
SPARK_WORKER_CORES=4
SPARK_WORKER_MEMORY=6g
SPARK_DRIVER_MEMORY=3g
SPARK_EXECUTOR_MEMORY=2g
SPARK_EXECUTOR_CORES=2
SPARK_CORES_MAX=8
FLINK_TM_PROCESS_MEMORY=2560m
FLINK_TM_SLOTS=4
KAFKA_HEAP_OPTS="-Xmx768m -Xms768m"

# --- Lakekeeper ---
LAKEKEEPER_PG_ENCRYPTION_KEY=change-me-32-bytes-minimum-key-000000
